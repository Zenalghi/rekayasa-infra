# =====================================================================
# DOCKER INFRASTRUCTURE SECRETS
# =====================================================================
# Variabel ini hanya digunakan untuk layer infrastruktur.
# Credential spesifik aplikasi (.env aplikasi) tidak boleh diletakkan di sini.

MYSQL_ROOT_PASSWORD=
NPM_DB_PASSWORD=

# =====================================================================
# KONFIGURASI BACKUP
# =====================================================================
# Konfigurasi folder tujuan backup dan lama retensi.
BACKUP_DIR=/mnt/data/backups
RETENTION_DAYS=7
